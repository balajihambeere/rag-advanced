# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# Chapter 8 — round-robin between two keys at 600 qpm campaign load.
# Falls back to OPENAI_API_KEY alone if SECONDARY is unset.
# OPENAI_API_KEY_PRIMARY=sk-your-primary-key
# OPENAI_API_KEY_SECONDARY=sk-your-secondary-key

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.qdrant.cloud
QDRANT_API_KEY=your-qdrant-api-key

# ── Redis (Chapter 6 — memory, Chapter 7 — cache) ────────────────────────────
REDIS_URL=redis://default:your-password@your-redis-host:6379/0

# ── Rerank + embed microservice ──────────────────────────────────────────────
# Required — this process has no in-process cross-encoder or ONNX embedder, it
# only calls this service (retrieval/rerank_client.py, infra/clients.py). It's
# a separate standalone project, ../shopbot-rerank/, not a subfolder of this
# one. Run it locally via Docker before starting the API:
#   cd ../shopbot-rerank && docker build -t shopbot-rerank . && docker run -p 8001:8001 shopbot-rerank
RERANK_URL=http://localhost:8001

# ── Google Sheets service account (Chapter 8 RAGAS Monday) ───────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ── MLflow tracking (eval metrics + API tracing) ─────────────────────────────
# Start the server: docker compose up -d (this project's own docker-compose.yml)
# Leave unset to disable silently.
# MLFLOW_TRACKING_URI=http://localhost:5001
